# =====================================================================================
# REGISMEET — Environment Configuration Template
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env` file.
# =====================================================================================

ENVIRONMENT=development

# ------------------------------------------------------------------ Supabase
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_AUDIO_BUCKET=webinar-audio

# ------------------------------------------------------------------ Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ------------------------------------------------------------------ Upstash QStash
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key
PUBLIC_APP_URL=https://your-deployed-app.vercel.app/

# ------------------------------------------------------------------ AI providers
GEMINI_API_KEY=your-google-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ------------------------------------------------------------------ Paystack
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key

# ------------------------------------------------------------------ Resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_ADDRESS=alerts@yourdomain.com

# ------------------------------------------------------------------ Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ------------------------------------------------------------------ CORS
# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com