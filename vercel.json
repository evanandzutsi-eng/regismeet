{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/process-job", "destination": "/api/process_job" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    },
    "api/process_job.py": {
      "maxDuration": 300
    }
  }
}
